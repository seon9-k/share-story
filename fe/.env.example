DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=share_story
DIALECT=postgres
JWT_SECRET=your_jwt_secret
SALT_ROUNDS=10

# 비밀값(토큰, 커넥션 스트링)은 절대 VITE_* 로 두지 말 것 — 브라우저에 그대로 노출된다.

# 백엔드 절대 주소. 비워두면 상대경로 + vite 프록시(개발)로 동작한다.
VITE_API_BASE_URL=

# vite dev server 프록시 대상 (로컬 be 주소)
VITE_PROXY_TARGET=http://127.0.0.1:3000
