{
  "name": "share-story-be",
  "version": "1.0.0",
  "description": "쉐어 스토리 백엔드",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node database/seeders/seed.js",
    "db:check": "node scripts/db-check.js",
    "seed:zoom-mail": "node scripts/seed-zoom-mail-candidate.js",
    "db:check:local": "node --env-file=.env.local scripts/db-check.js",
    "dev:local": "nodemon --exec \"node --env-file=.env.local\" src/server.js",
    "fix:image-urls": "node scripts/fix-broken-image-urls.js",
    "fix:image-urls:local": "node --env-file=.env.local scripts/fix-broken-image-urls.js",
    "seed:local": "node --env-file=.env.local database/seeders/seed.js",
    "test": "node --test tests/unit/member.test.js",
    "test:db": "node --test tests/integration/db-check.test.js"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
