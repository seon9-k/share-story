# Database
DB_HOST=your_host
DB_PORT=5432
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=share_story
DIALECT=postgres
DB_SSL=true

# JWT
JWT_SECRET=your_jwt_secret
# 토큰 만료 (기본 1d = 하루)
JWT_EXPIRES_IN=1d
# 비밀번호 해시 강도 (auth.service.js가 읽는 키)
SALT_ROUNDS=10

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
AZURE_STORAGE_CONTAINER_NAME=images
# 배치 API 인증 키 (로컬 개발용, functions-batch/local.settings.json과 같은 값)
BATCH_API_KEY=local-dev-key

# 메일 발송 (Zoom 접속 안내·로그북 제출 안내). 미설정 시 발송이 모두 실패하고 /session/* 배치가 500을 반환함
# App Service 앱 설정(운영·staging 슬롯 모두)에도 같은 키를 등록할 것
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
# 발신자 주소. 비우면 SMTP_USER를 사용
MAIL_FROM=
