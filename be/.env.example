# Database
DB_HOST=your_host
DB_PORT=5432
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=share_story
DIALECT=postgres
DB_SSL=true

# JWT
JWT_SECRET=your_jwt_secret
# 토큰 만료 (기본 1d = 하루)
JWT_EXPIRES_IN=1d
# 비밀번호 해시 강도 (auth.service.js가 읽는 키)
SALT_ROUNDS=10

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
AZURE_STORAGE_CONTAINER_NAME=images